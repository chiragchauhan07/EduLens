# Vercel Deployment Ignore Rules
# Exclude heavy datasets, training scripts, tests, and documentation from the serverless bundle

# Raw and processed datasets
data/

# Prototyping, training, and evaluation suites
ml_prototype/
scripts/
generate_dataset.py
reports/

# Tests & fixtures
tests/
samples/
pytest.ini
.pytest_cache/

# Documentation and PDF specifications
docs/
*.pdf
*.md
!README.md

# Virtual environments & Git
.venv/
venv/
env/
.git/
.gitignore

# Python caches
__pycache__/
*.py[cod]
*$py.class
*.so
.ipynb_checkpoints/
