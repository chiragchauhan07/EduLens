-
-            <!-- Trend Polyline -->
-            <path d="${pathD}" fill="none" stroke="#2457A6" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
-          `;
-
-          // Add Circles with tooltips
-          points.forEach(p => {
-            markup += `
-              <circle cx="${p.x}" cy="${p.y}" r="4.5" fill="#FFFFFF" stroke="#2457A6" stroke-width="2" class="cursor-pointer hover:r-6 transition-all">
-                <title>${p.topic}: ${Math.round(p.val)}% (${p.date})</title>
