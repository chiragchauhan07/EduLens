-            <line x1="40" y1="180" x2="680" y2="180" stroke="#EEF2F7" stroke-width="1" class="dark:stroke-dark-border" />
-
-            <!-- Labels -->
-            <text x="10" y="34" fill="#94A3B8" font-size="10" font-family="Inter">100</text>
-            <text x="10" y="78" fill="#23865B" font-size="9" font-family="Inter" font-weight="600">70%</text>
