-        renderDonut(dist) {
-          const u = dist.understood || 0;
-          const p = dist.partial || 0;
-          const c = dist.confused || 0;
-          const total = u + p + c;
-
-          document.getElementById("dist-total-badge").textContent = `${total} Sessions`;
-          document.getElementById("dist-count-u").textContent = u;
-          document.getElementById("dist-count-p").textContent = p;
-          document.getElementById("dist-count-c").textContent = c;
-
-          const pctU = total ? Math.round((u / total) * 100) : 0;
-          const pctP = total ? Math.round((p / total) * 100) : 0;
-          const pctC = total ? Math.round((c / total) * 100) : 0;
-
-          document.getElementById("dist-pct-u").textContent = `${pctU}%`;
-          document.getElementById("dist-pct-p").textContent = `${pctP}%`;
-          document.getElementById("dist-pct-c").textContent = `${pctC}%`;
-          document.getElementById("donut-center-pct").textContent = total ? `${pctU}%` : "--%";
-
-          // Circumference for r=62 is 2 * PI * 62 ≈ 389.55
-          const circ = 389.55;
-          const dashU = (pctU / 100) * circ;
-          const dashP = (pctP / 100) * circ;
-          const dashC = (pctC / 100) * circ;
-
-          const elU = document.getElementById("donut-understood");
-          const elP = document.getElementById("donut-partial");
-          const elC = document.getElementById("donut-confused");
-
-          if (elU && elP && elC) {
-            elU.setAttribute("stroke-dasharray", `${dashU} ${circ}`);
-            elU.setAttribute("stroke-dashoffset", "0");
-
-            elP.setAttribute("stroke-dasharray", `${dashP} ${circ}`);
-            elP.setAttribute("stroke-dashoffset", `-${dashU}`);
-
-            elC.setAttribute("stroke-dasharray", `${dashC} ${circ}`);
-            elC.setAttribute("stroke-dashoffset", `-${dashU + dashP}`);
-          }
-        },
