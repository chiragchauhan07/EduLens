+.collapsed .brand-text, .collapsed .nav-label, .collapsed .who-text { display: none; }
+.collapsed .nav-link { justify-content: center; padding: 10px; } .collapsed .brand { justify-content: center; padding-inline: 0; }
+.collapsed .who { justify-content: center; }
+.main-col { min-width: 0; display: flex; flex-direction: column; }
+.topbar { position: sticky; top: 0; z-index: 20; height: var(--topbar-h); background: color-mix(in srgb, var(--bg) 92%, transparent); backdrop-filter: blur(8px); border-bottom: 1px solid var(--border); display: flex; align-items: center; gap: 12px; padding: 0 28px; }
+.topbar .spacer { flex: 1; }
+.student-select { display: flex; align-items: center; gap: 8px; }
+.student-select select { max-width: 180px; }
+main { padding: 28px; width: 100%; max-width: 1120px; margin: 0 auto; flex: 1; }
+.page-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; flex-wrap: wrap; margin-bottom: 24px; }
+.page-head p { color: var(--text-2); margin-top: 4px; max-width: 62ch; }
+.bottom-nav { display: none; }
+
+/* ---------- Controls ---------- */
+.btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 40px; padding: 8px 16px; border-radius: var(--radius-sm); border: 1px solid var(--border); background: var(--surface); color: var(--text); font-weight: 600; font-size: 14px; cursor: pointer; text-decoration: none; }
+.btn:hover { background: var(--muted); }
+.btn-primary { background: var(--primary); border-color: var(--primary); color: #fff; }
+.btn-primary:hover { background: var(--primary-strong); }
+:root[data-theme="dark"] .btn-primary { color: #0B0F17; } :root[data-theme="dark"] .btn-primary:hover { color: #0B0F17; }
+.btn-ghost { border-color: transparent; background: transparent; } .btn-sm { min-height: 34px; padding: 4px 12px; font-size: 13px; }
+.btn[disabled] { opacity: .55; cursor: not-allowed; }
+.icon-btn { width: 40px; height: 40px; padding: 0; }
+input[type=text], input[type=search], select, textarea { width: 100%; min-height: 40px; padding: 8px 12px; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-sm); }
+textarea { resize: vertical; min-height: 140px; line-height: 1.5; }
+select { width: auto; }
+label.field { display: flex; flex-direction: column; gap: 6px; font-weight: 600; font-size: 13px; }
+.field-hint { font-weight: 400; color: var(--text-2); font-size: 12.5px; }
+
+/* ---------- Surfaces ---------- */
+.card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); box-shadow: var(--shadow); padding: 20px; }
+.card-head { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; margin-bottom: 14px; }
+.card-head p { color: var(--text-2); font-size: 13px; }
+.grid { display: grid; gap: 16px; } .g4 { grid-template-columns: repeat(4, 1fr); } .g2 { grid-template-columns: 1fr 1fr; }
+.stack { display: flex; flex-direction: column; gap: 20px; }
+.metric { display: flex; flex-direction: column; gap: 4px; }
+.metric .label { color: var(--text-2); font-size: 13px; font-weight: 500; }
+.metric .value { font-family: var(--font-head); font-size: 28px; font-weight: 700; line-height: 1.2; }
+.metric .value.is-empty { font-size: 17px; font-weight: 600; color: var(--text-2); padding: 5px 0; }
+.metric .note { color: var(--text-2); font-size: 12.5px; }
+.pill { display: inline-flex; align-items: center; gap: 6px; padding: 2px 10px; border-radius: 999px; font-size: 12.5px; font-weight: 600; white-space: nowrap; background: var(--muted); color: var(--text-2); }
+.pill::before { content: ""; width: 7px; height: 7px; border-radius: 50%; background: currentColor; }
+.pill.green { background: var(--green-soft); color: var(--green); } .pill.amber { background: var(--amber-soft); color: var(--amber); }
+.pill.red { background: var(--red-soft); color: var(--red); } .pill.blue { background: var(--primary-soft); color: var(--primary); }
+.list { list-style: none; margin: 0; padding: 0; }
+.list > li { display: flex; align-items: center; gap: 12px; justify-content: space-between; padding: 12px 0; border-top: 1px solid var(--border); }
+.list > li:first-child { border-top: 0; padding-top: 0; } .list > li:last-child { padding-bottom: 0; }
+.li-main { min-width: 0; } .li-title { font-weight: 600; overflow: hidden; text-overflow: ellipsis; }
+.li-sub { color: var(--text-2); font-size: 13px; }
+.row-link { text-decoration: none; color: inherit; display: block; }
+.empty { text-align: center; padding: 36px 16px; color: var(--text-2); display: flex; flex-direction: column; align-items: center; gap: 10px; }
+.empty h3 { color: var(--text); } .empty p { max-width: 46ch; }
+.notice { background: var(--primary-soft); color: var(--text); border-radius: var(--radius-sm); padding: 10px 14px; font-size: 13.5px; }
+.error-box { border: 1px solid var(--red); background: var(--red-soft); border-radius: var(--radius); padding: 16px 20px; display: flex; gap: 12px; align-items: center; justify-content: space-between; flex-wrap: wrap; }
+.skel { background: linear-gradient(90deg, var(--muted), var(--border), var(--muted)); background-size: 200% 100%; animation: sh 1.4s infinite; border-radius: 8px; }
+@keyframes sh { to { background-position: -200% 0; } }
+@media (prefers-reduced-motion: reduce) { .skel { animation: none; } * { scroll-behavior: auto !important; transition: none !important; } }
+.progress { height: 8px; background: var(--muted); border-radius: 999px; overflow: hidden; } .progress > span { display: block; height: 100%; background: var(--primary); }
+
+/* ---------- Sessions ---------- */
+.toolbar { display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 16px; }
+.toolbar .grow { flex: 1 1 240px; min-width: 200px; } .toolbar select { min-height: 40px; }
+.session-row { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 1.3fr) 150px 120px 112px; gap: 16px; align-items: center; padding: 14px 20px; border-top: 1px solid var(--border); }
+.session-row:first-child { border-top: 0; }
+.quiz-cell { font-size: 13.5px; min-width: 110px; } .quiz-cell strong { font-size: 15px; }
+.pager { display: flex; justify-content: space-between; align-items: center; padding: 14px 20px; border-top: 1px solid var(--border); }
+.card.flush { padding: 0; overflow: hidden; }
+
+/* ---------- Transcript ---------- */
+.transcript { display: flex; flex-direction: column; gap: 12px; max-height: 560px; overflow: auto; padding: 4px; }
+.msg { max-width: 78%; padding: 10px 14px; border-radius: 14px; white-space: pre-wrap; overflow-wrap: anywhere; }
+.msg .who-tag { display: block; font-size: 12px; font-weight: 700; margin-bottom: 2px; }
+.msg.student { align-self: flex-end; background: var(--primary-soft); border-bottom-right-radius: 4px; } .msg.student .who-tag { color: var(--primary); }
+.msg.ai { align-self: flex-start; background: var(--muted); border-bottom-left-radius: 4px; } .msg.ai .who-tag { color: var(--text-2); }
+
+/* ---------- Tables / tabs / misc ---------- */
+.table-wrap { overflow-x: auto; }
+table { width: 100%; border-collapse: collapse; font-size: 14px; }
+th { text-align: left; font-weight: 600; font-size: 13px; color: var(--text-2); padding: 10px 14px; border-bottom: 1px solid var(--border); white-space: nowrap; }
+td { padding: 12px 14px; border-bottom: 1px solid var(--border); vertical-align: middle; } tr:last-child td { border-bottom: 0; }
+.tabs { display: inline-flex; background: var(--muted); padding: 4px; border-radius: 10px; gap: 2px; margin-bottom: 20px; }
+.tab { border: 0; background: transparent; padding: 8px 16px; border-radius: 8px; font-weight: 600; font-size: 14px; color: var(--text-2); cursor: pointer; min-height: 36px; }
+.tab[aria-selected="true"] { background: var(--surface); color: var(--text); box-shadow: var(--shadow); }
+details.disclosure { border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface); }
+details.disclosure > summary { cursor: pointer; padding: 14px 20px; font-weight: 600; list-style: none; display: flex; justify-content: space-between; align-items: center; min-height: 48px; }
+details.disclosure > summary::-webkit-details-marker { display: none; }
+details.disclosure > summary::after { content: "+"; font-size: 20px; color: var(--text-2); } details[open].disclosure > summary::after { content: "–"; }
+details.disclosure > .body { padding: 0 20px 20px; }
+.kv { display: grid; grid-template-columns: max-content 1fr; gap: 6px 18px; font-size: 14px; } .kv dt { color: var(--text-2); } .kv dd { margin: 0; overflow-wrap: anywhere; }
+.chips { display: flex; flex-wrap: wrap; gap: 8px; } .chip { background: var(--muted); border-radius: 999px; padding: 4px 12px; font-size: 13px; }
+.steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
+.step { display: flex; flex-direction: column; gap: 8px; } .step-num { width: 32px; height: 32px; border-radius: 50%; background: var(--primary); color: #fff; display: grid; place-items: center; font-weight: 700; }
+:root[data-theme="dark"] .step-num { color: #0B0F17; }
+pre.code { background: var(--muted); border-radius: var(--radius-sm); padding: 12px 14px; overflow-x: auto; font: 12.5px/1.55 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; margin: 8px 0 0; }
+.sig-list { display: grid; grid-template-columns: repeat(2, 1fr); gap: 4px 24px; } .sig-list div { display: flex; justify-content: space-between; border-bottom: 1px dashed var(--border); padding: 6px 0; font-size: 14px; }
+.legend { display: flex; gap: 18px; font-size: 13px; color: var(--text-2); margin-top: 8px; flex-wrap: wrap; } .legend i { display: inline-block; width: 18px; height: 3px; border-radius: 2px; vertical-align: middle; margin-right: 6px; }
+svg.chart text { fill: var(--text-2); font-size: 11px; font-family: var(--font); } svg.chart .grid-line { stroke: var(--border); } 
+.crumb { display: inline-flex; align-items: center; gap: 6px; text-decoration: none; font-weight: 600; font-size: 14px; margin-bottom: 14px; }
+.q-item { padding: 12px 0; border-top: 1px solid var(--border); } .q-item:first-child { border-top: 0; }
+.q-row { display: grid; grid-template-columns: 2fr 1fr 1fr auto; gap: 8px; align-items: end; margin-bottom: 10px; }
+
+/* ---------- Dialog & toast ---------- */
+dialog { border: 1px solid var(--border); border-radius: 16px; padding: 0; width: min(640px, calc(100vw - 24px)); max-height: calc(100vh - 24px); background: var(--surface); color: var(--text); }
+dialog::backdrop { background: rgba(11,15,23,.5); }
+.dlg-head { display: flex; justify-content: space-between; align-items: center; padding: 18px 22px; border-bottom: 1px solid var(--border); }
+.dlg-body { padding: 20px 22px; display: flex; flex-direction: column; gap: 14px; overflow: auto; max-height: calc(100vh - 190px); }
+.dlg-foot { padding: 14px 22px; border-top: 1px solid var(--border); display: flex; justify-content: flex-end; gap: 10px; align-items: center; }
+.dlg-foot .status { margin-right: auto; font-size: 13px; color: var(--text-2); }
+#toasts { position: fixed; right: 20px; bottom: 20px; display: flex; flex-direction: column; gap: 10px; z-index: 200; }
+.toast { background: var(--text); color: var(--bg); padding: 12px 16px; border-radius: 10px; font-size: 14px; max-width: 360px; box-shadow: 0 8px 24px rgba(0,0,0,.2); }
+.toast.error { background: var(--red); color: #fff; }
+.scrim { display: none; }
+
+/* ---------- Responsive ---------- */
+@media (max-width: 1024px) {
+  .app, .app.collapsed { grid-template-columns: 1fr; }
+  .sidebar { position: fixed; left: 0; top: 0; width: 280px; transform: translateX(-100%); transition: transform .2s; box-shadow: 0 0 40px rgba(0,0,0,.2); }
+  .app.drawer-open .sidebar { transform: none; }
+  .app.drawer-open .scrim { display: block; position: fixed; inset: 0; background: rgba(11,15,23,.45); z-index: 25; }
+  .collapsed .brand-text, .collapsed .nav-label, .collapsed .who-text { display: initial; } .collapsed .nav-link { justify-content: flex-start; padding: 10px 12px; }
+  .collapse-btn { display: none; }
+  .g4 { grid-template-columns: repeat(2, 1fr); }
+}
+@media (min-width: 1025px) { .menu-btn { display: none; } }
+@media (max-width: 760px) {
+  main { padding: 18px 16px 96px; } .topbar { padding: 0 14px; } h1 { font-size: 22px; }
+  .g2, .steps, .sig-list { grid-template-columns: 1fr; }
+  .session-row { grid-template-columns: 1fr auto; gap: 8px 12px; padding: 14px 16px; }
+  .session-row > :nth-child(2) { grid-column: 1 / -1; order: 3; } .session-row > :nth-child(5) { grid-column: 1 / -1; order: 5; }
+  .student-select label { display: none; } .student-select select { max-width: 130px; } .topbar .btn { white-space: nowrap; padding: 8px 12px; } .hide-sm { display: none; } svg.chart text { font-size: 17px; }
+  .q-row { grid-template-columns: 1fr; } .msg { max-width: 92%; }
+  .bottom-nav { display: grid; grid-template-columns: repeat(5, 1fr); position: fixed; bottom: 0; left: 0; right: 0; background: var(--surface); border-top: 1px solid var(--border); z-index: 20; padding-bottom: env(safe-area-inset-bottom); }
+  .bottom-nav a, .bottom-nav button { display: flex; flex-direction: column; align-items: center; gap: 2px; padding: 8px 2px; font-size: 11.5px; color: var(--text-2); text-decoration: none; background: none; border: 0; min-height: 56px; cursor: pointer; }
+  .bottom-nav [aria-current="page"] { color: var(--primary); font-weight: 600; }
+  #toasts { bottom: 76px; right: 12px; left: 12px; } .toast { max-width: none; }
+}
+@media (max-width: 420px) { .g4 { grid-template-columns: 1fr 1fr; gap: 10px; } .card { padding: 16px; } .metric .value { font-size: 24px; } }
