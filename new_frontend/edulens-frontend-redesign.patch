+/* EduLens — student learning dashboard styles */
+:root {
+  --bg: #F6F8FB; --surface: #FFFFFF; --muted: #EEF2F7; --border: #E4E8EF;
+  --text: #172033; --text-2: #5B6678;
+  --primary: #2457A6; --primary-strong: #003F89; --primary-soft: #E8EEFF;
+  --green: #23865B; --green-soft: #E6F4EC;
+  --amber: #8F5C0C; --amber-soft: #FBF1DC;
+  --red: #C23B3B; --red-soft: #FBE9E9;
+  --shadow: 0 1px 2px rgba(23,32,51,.06);
+  --radius: 12px; --radius-sm: 8px;
+  --sidebar-w: 248px; --sidebar-w-collapsed: 72px; --topbar-h: 64px;
+  --font: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
+  --font-head: "Manrope", "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
+}
+:root[data-theme="dark"] {
+  --bg: #0B0F17; --surface: #131B2A; --muted: #1C2638; --border: #28354A;
+  --text: #F1F5F9; --text-2: #9FB0C6;
+  --primary: #7FA8F0; --primary-strong: #A9C4F7; --primary-soft: #1B2A47;
+  --green: #4FC08A; --green-soft: #12301F;
+  --amber: #E5B35B; --amber-soft: #382B10;
+  --red: #F08080; --red-soft: #3A1B1B;
+  --shadow: none;
+}
+* { box-sizing: border-box; }
+html, body { height: 100%; }
+body { margin: 0; background: var(--bg); color: var(--text); font: 15px/1.5 var(--font); -webkit-font-smoothing: antialiased; }
+h1, h2, h3 { font-family: var(--font-head); margin: 0; line-height: 1.25; letter-spacing: -0.01em; }
+h1 { font-size: 26px; font-weight: 700; } h2 { font-size: 18px; font-weight: 700; } h3 { font-size: 15px; font-weight: 600; }
+p { margin: 0; }
+a { color: var(--primary); }
+button, input, select, textarea { font: inherit; color: inherit; }
+:focus-visible { outline: 3px solid var(--primary); outline-offset: 2px; border-radius: 6px; }
+h1[tabindex="-1"]:focus { outline: none; }
+body[data-route="overview"] .topbar [data-action="open-ingest"] { display: none; }
+.sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
+.skip-link { position: absolute; left: 12px; top: -48px; background: var(--primary-strong); color: #fff; padding: 8px 14px; border-radius: 8px; z-index: 100; }
+.skip-link:focus { top: 12px; }
+.icon { width: 20px; height: 20px; flex: none; stroke: currentColor; fill: none; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
+.muted { color: var(--text-2); } .small { font-size: 13px; }
+
+/* ---------- App shell ---------- */
+.app { display: grid; grid-template-columns: var(--sidebar-w) 1fr; min-height: 100%; }
+.app.collapsed { grid-template-columns: var(--sidebar-w-collapsed) 1fr; }
+.sidebar { position: sticky; top: 0; height: 100vh; background: var(--surface); border-right: 1px solid var(--border); display: flex; flex-direction: column; padding: 16px 12px; gap: 8px; z-index: 30; }
+.brand { display: flex; align-items: center; gap: 10px; padding: 6px 10px 14px; font-family: var(--font-head); font-weight: 800; font-size: 18px; color: var(--text); text-decoration: none; }
+.brand-mark { width: 32px; height: 32px; border-radius: 9px; background: var(--primary); color: #fff; display: grid; place-items: center; flex: none; }
+.brand-mark .icon { stroke: #fff; }
+.nav-group { display: flex; flex-direction: column; gap: 2px; }
+.nav-sep { height: 1px; background: var(--border); margin: 10px 8px; }
+.nav-link { display: flex; align-items: center; gap: 12px; padding: 10px 12px; border-radius: var(--radius-sm); color: var(--text-2); text-decoration: none; font-weight: 500; min-height: 44px; }
+.nav-link:hover { background: var(--muted); color: var(--text); }
+.nav-link[aria-current="page"] { background: var(--primary-soft); color: var(--primary); font-weight: 600; }
+.sidebar-foot { margin-top: auto; display: flex; flex-direction: column; gap: 8px; }
+.who { display: flex; align-items: center; gap: 10px; padding: 8px 10px; border-radius: var(--radius-sm); }
+.avatar { width: 34px; height: 34px; border-radius: 50%; background: var(--primary-soft); color: var(--primary); display: grid; place-items: center; font-weight: 700; font-size: 13px; flex: none; }
