-        renderTrend(trendItems) {
-          const svg = document.getElementById("trend-svg");
-          if (!svg) return;
-
-          const metricKey = EduLens.state.trendMetric === "quiz" ? "quiz_score" : 
-                            (EduLens.state.trendMetric === "composite" ? "overall_score" : "understanding_score");
-          const metricName = EduLens.state.trendMetric === "quiz" ? "Quiz Score" : 
-                            (EduLens.state.trendMetric === "composite" ? "Composite Score" : "Understanding Score");
-
-          if (!trendItems || trendItems.length === 0) {
-            const countLabel = document.getElementById("trend-count-label");
-            if (countLabel) countLabel.textContent = "0 sessions";
-            svg.innerHTML = `
-              <text x="350" y="100" text-anchor="middle" fill="#94A3B8" font-size="12" font-family="Inter">
-                No session timeline progression recorded yet for this student.
-              </text>
-            `;
-            return;
-          }
-
-          // Filter items that have score - NEVER fall back to 50 or other metrics
-          const validItems = trendItems.filter(item => item[metricKey] !== null && item[metricKey] !== undefined);
-
-          const countLabel = document.getElementById("trend-count-label");
-          if (countLabel) {
-            countLabel.textContent = `${validItems.length} of ${trendItems.length} sessions with ${metricName}`;
-          }
-
-          if (validItems.length === 0) {
-            svg.innerHTML = `
-              <text x="350" y="100" text-anchor="middle" fill="#94A3B8" font-size="12" font-family="Inter">
-                No ${metricName.toLowerCase()}s recorded yet for this student.
-              </text>
-            `;
-            return;
-          }
-
-          const points = validItems.map((item, idx) => {
-            const val = Number(item[metricKey]);
-            return {
-              x: validItems.length === 1 ? 350 : 40 + (idx / Math.max(1, validItems.length - 1)) * 620,
-              y: 180 - (Math.max(0, Math.min(100, val)) / 100) * 150,
-              val: val,
-              topic: item.topic || "Unspecified Topic",
-              date: item.date ? item.date.substring(5, 10) : `#${idx + 1}`
-            };
-          });
-
-          // Build SVG path
-          let pathD = `M ${points[0].x} ${points[0].y}`;
-          for (let i = 1; i < points.length; i++) {
-            pathD += ` L ${points[i].x} ${points[i].y}`;
-          }
-
-          // Render Grid & Line
-          let markup = `
-            <!-- Grid Lines -->
-            <line x1="40" y1="30" x2="680" y2="30" stroke="#EEF2F7" stroke-dasharray="4 4" stroke-width="1" class="dark:stroke-dark-border" />
