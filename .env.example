# ==============================================================================
# EduLens Environment Configuration
# ==============================================================================

# Server Identity & Protocol Metadata
EDULENS_MCP_NAME=EduLens Analytics Engine
EDULENS_MCP_VERSION=1.0.0
EDULENS_ENVIRONMENT=development

# Server Network & Transport Settings
# Supported transports: sse | streamable | stdio
EDULENS_MCP_TRANSPORT=sse
EDULENS_MCP_HOST=127.0.0.1
EDULENS_MCP_PORT=8001

# Authentication & Security Settings
# In production, set EDULENS_AUTH_ENABLED=true
EDULENS_AUTH_ENABLED=true
EDULENS_AUTH_SECRET=edulens-super-secure-jwt-hmac-secret-change-in-production-2025

# Pre-seeded Development API Tokens (Formatted as: token1:student1,token2:student2)
EDULENS_API_TOKENS=edulens-dev-token-student-001:student_001,edulens-dev-token-student-002:student_002

# Storage Configuration
EDULENS_STORAGE_DIR=data/storage
EDULENS_DB_NAME=edulens.db

# Model & ML Pipeline Configuration
EDULENS_MODEL_DIR=models
EDULENS_CLASSIFIER_MODEL=logistic_regression
EDULENS_REGRESSOR_MODEL=ridge

