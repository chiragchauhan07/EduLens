# ==============================================================================
# EduLens Environment Configuration
# ==============================================================================

# Server Identity & Protocol Metadata
EDULENS_MCP_NAME=EduLens Analytics Engine
EDULENS_MCP_VERSION=1.0.0

# Runtime Environment: 'development', 'test', or 'production'
# In production, dev tokens are never seeded, and query tokens are strictly rejected.
EDULENS_ENVIRONMENT=development

# Server Network & Transport Settings
# Supported transports: streamable | sse | stdio
# Streamable HTTP (/mcp) is the recommended transport for HTTP-based MCP deployments.
EDULENS_MCP_TRANSPORT=streamable
EDULENS_MCP_HOST=127.0.0.1
EDULENS_MCP_PORT=8001

# Authentication & Security Settings
EDULENS_AUTH_ENABLED=true
# Allow auth token via query parameter (strictly disabled in production, optional in local dev)
EDULENS_ALLOW_QUERY_TOKEN=false
EDULENS_AUTH_SECRET=edulens-super-secure-jwt-hmac-secret-change-in-production-2025

# Development-Only Tokens (Used for local testing and automated tests)
# DO NOT USE IN PRODUCTION. In production, configure cryptographically random tokens or OAuth 2.1.
EDULENS_DEV_USER=student_001
EDULENS_DEV_TOKEN=edulens-dev-token-student-001

# Static API Tokens Mapping (Comma-separated token:student_id pairs)
# Example: EDULENS_API_TOKENS=<SECURE_TOKEN_1>:<STUDENT_ID_1>,<SECURE_TOKEN_2>:<STUDENT_ID_2>
# Note: In-memory static Bearer tokens work with clients that support custom HTTP headers
# (e.g. Claude Desktop, MCP Inspector, custom SDK clients). They do NOT provide OAuth 2.1 for ChatGPT.
EDULENS_API_TOKENS=

# Storage Configuration
EDULENS_STORAGE_DIR=data/storage
EDULENS_DB_NAME=edulens.db

# Model & ML Pipeline Configuration
EDULENS_MODEL_DIR=models
EDULENS_CLASSIFIER_MODEL=logistic_regression
EDULENS_REGRESSOR_MODEL=ridge
